# Copy to .env and fill in real values. .env is gitignored — never commit it.

# From ./data/daemon.token after the daemon's first run (same value already
# on disk — recreating the containers does not change it as long as ./data
# is preserved).
WHATSAPP_MCP_DAEMON_TOKEN=

# Bearer token required on the mcp-server's HTTP transport. Pick any random
# string and keep it in sync with whatever value is registered as this
# server's MCP client credential.
WHATSAPP_MCP_HTTP_TOKEN=
